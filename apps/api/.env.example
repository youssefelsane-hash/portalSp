# baytak api — انسخه لـ .env محلياً

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

DATABASE_URL=postgres://baytak:baytak@localhost:5432/baytak

# **سعة التزامن الحقيقية للمنصة.** كل نسخة من التطبيق بتحجز `DATABASE_POOL_MAX` اتصال من
# `max_connections` بتاع Postgres، والطلب اللي مالقاش اتصال خلال `DATABASE_ACQUIRE_TIMEOUT_MS`
# بيترفض بـ503 — يعني عميل حقيقي بيتقاله «النظام مزحوم». الرقم ده كان ١٠ وكان بيرفض ٧٠٪ من ٤٠
# حجز متزامن (قياس حي: `node scripts/concurrency-booking-safety.js --concurrency 40`).
#
# القاعدة: poolMax ≤ (max_connections − ١٠ للصيانة) ÷ عدد نسخ التطبيق.
# التطبيق بيطبع الرقمين الحقيقيين وقت الإقلاع (DbPoolMonitorService) فمفيش تخمين.
DATABASE_POOL_MAX=20
DATABASE_ACQUIRE_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d
# مفتاح رئيسي لتشفير أسرار Paymob المخزنة من لوحة الإدارة. استخدم قيمة عشوائية 32+ حرفًا
# وثبّتها بين عمليات النشر؛ تغييرها يمنع فك القيم المحفوظة سابقًا.
SETTINGS_ENCRYPTION_KEY=change-me-settings-encryption-key
# مفتاح تشفير بيانات الهوية (الرقم القومي للفني — ADR-0045). لو مش متظبط، بيرجع لـ
# SETTINGS_ENCRYPTION_KEY. **تغييره بعد التشغيل بيبطّل فك التشفير وكل الهاشات المخزّنة** —
# يعني التفرّد بيتلف والأرقام القديمة مش هتتقرا. اتعامل معاه كسر دايم.
PII_ENCRYPTION_KEY=change-me-pii-encryption-key-32ch

# قائمة أصول (origins) مسموح لها بنداء الـAPI من متصفح، مفصولة بفاصلة (مثال:
# https://admin.ostahome.com,https://ostahome.com). فاضي = مفتوح للكل (*) — مقبول محلياً/تطويرياً
# بس، السيرفر بيرفض يشتغل لو سيبتها فاضية وNODE_ENV=production (راجع src/config/env.validation.ts).
CORS_ORIGIN=

OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# WebAuthn/Passkeys لدخول الأدمن عالي الصلاحية (ADR-0011) — القيم دي افتراضاتها مضبوطة لبيئة
# التطوير المحلية (apps/admin على 3001) وشغالة من غير أي تعديل. **لازم تتظبط صح في الإنتاج**:
# WEBAUTHN_RP_ID = دومين لوحة الأدمن الحقيقي بدون بروتوكول (مثال: admin.ostahome.com)،
# WEBAUTHN_ORIGIN = نفس الدومين كامل بالـhttps (مثال: https://admin.ostahome.com) — غلط في القيمتين
# دول بيخلي كل WebAuthn ceremony يترفض من المتصفح نفسه (WebAuthn spec، مش قيد من كودنا).
WEBAUTHN_RP_NAME=أسطى — لوحة التحكم
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001

# تخزين الملفات — 'local' (افتراضي، للتطوير) أو 's3'. راجع common/storage/README.md
# و docs/03-external-integrations.md لتفاصيل كل قيمة S3.
# docs/08 §19 بند 16: 's3' إجباري لو NODE_ENV=production — السيرفر يرفض يقلع بـ'local' في الإنتاج
# (ملف مؤقت بيتمسح مع كل deploy، مش متاح لأكتر من instance).
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
# رابط الـAPI العام المطلق — لازم يبقى شامل scheme+host+port، مش مسار نسبي (بَقّة حقيقية
# 2026-08-23: apps/admin/customer-web/تطبيقات Flutter كلهم على أصل مختلف عن الـAPI، فرابط نسبي
# زي `/uploads/...` كان بيتحل ضد أصل الصفحة نفسها بدل أصل الـAPI = صورة معطوبة). فاضي = افتراضي
# http://localhost:<PORT> (شغال بدون تعديل لبيئة التطوير المحلية). لازم يتظبط لدومين الـAPI
# الحقيقي في أي بيئة staging محلية-التخزين (نادرًا — الإنتاج بيرفض 'local' أصلاً، فوق).
STORAGE_LOCAL_PUBLIC_BASE_URL=

# القيم دي مطلوبة فعلياً بس لو STORAGE_PROVIDER=s3 — تشتغل مع AWS S3 نفسه (اسيب S3_ENDPOINT فاضي)
# أو أي بديل S3-compatible زي DigitalOcean Spaces / Cloudflare R2 / MinIO (لازم S3_ENDPOINT).
#
# **إنتاج Osta = Cloudflare R2** (bucket: osta-production). القيم:
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com   (من لوحة R2 → Account ID)
#   S3_REGION=auto                                              (R2 مالوش أقاليم فعلية)
#   S3_BUCKET=osta-production
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY = من R2 → Manage API Tokens (صلاحية Object Read & Write
#     على الـbucket ده بس — مش Account-wide). **السر بيتعرض مرة واحدة عند الإنشاء.**
#   S3_FORCE_PATH_STYLE=true
# ممنوع تمامًا وضع أي من دول في كود Flutter أو أي واجهة أمامية — سيرفر بس.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
STORAGE_S3_URL_EXPIRY_SECONDS=604800

# قنوات الإشعارات الخارجية — كل واحدة اختيارية ومستقلة عن الباقي. قناة مش مُعدّة بترجع
# log-only (بتتسجّل في اللوج بس) بدل ما تفشّل أو توقف باقي القنوات. تفاصيل كل قيمة:
# docs/03-external-integrations.md
# استثناء واحد (docs/08 §19 بند 16): بوابة الـSMS **للمزوّد المختار** إجبارية لو
# NODE_ENV=staging/production — القناة الوحيدة لتسليم كود OTP، من غيرها مفيش مستخدم حقيقي يقدر
# يسجّل دخول أصلاً (السيرفر يرفض يقلع بدل ما OTP يرجع 200 بلا ما حد يستلمه فعليًا).
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── بوابة الـSMS ────────────────────────────────────────────────────────────────
# المزوّد الفعّال: cequens (الافتراضي، المعتمد لمصر) أو twilio (بديل احتياطي). الاختيار بيتم وقت
# التركيب في common/notifications/sms-dispatcher.provider.ts، والمستهلكين بيحقنوا SMS_DISPATCHER.
#
# **دورة حياة الـOTP بتفضل ملك Osta بالكامل**: التوليد، الهاش بـbcrypt، الصلاحية، عدد المحاولات،
# إبطال الكود القديم عند إعادة الإرسال، والتحقق — كله في قاعدة بياناتنا. المزوّد قناة تسليم نص وبس؛
# **مابنستخدمش أي Verify API خارجي**.
SMS_PROVIDER=cequens
# CEQUENS بيقبل مسارين للمصادقة — املا **واحد** منهم:
#   (أ) مفتاح API جاهز: لوحة CEQUENS → Developers → Create API Key (اسم + تاريخ انتهاء).
#   (ب) تبادل OAuth2: بيانات الحساب الأربعة تحت.
# CEQUENS_SENDER_NAME إجباري في الحالتين — لازم Sender ID معتمد لمصر، وإلا الرسالة بترفض من المزوّد.
CEQUENS_API_KEY=
CEQUENS_CLIENT_ID=
CEQUENS_CLIENT_SECRET=
CEQUENS_USERNAME=
CEQUENS_PASSWORD=
CEQUENS_SENDER_NAME=
# سيبهم فاضيين لاستخدام الافتراضي (https://apis.cequens.com/sms/v1 و.../auth/v1/tokens) — موجودين
# كمتغيرات عشان أي فرق في عقد الحساب يتظبط من البيئة بلا تعديل كود.
CEQUENS_BASE_URL=
CEQUENS_AUTH_URL=
# Twilio — بديل احتياطي للـSMS، ولسه المزوّد الوحيد لقناة WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=
TWILIO_WHATSAPP_FROM_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# كاش (SettingsService حالياً) — لو مش شغال، الكود بيرجع يقرا من القاعدة مباشرة من غير ما يفشل
REDIS_URL=redis://localhost:6379

# بوابة الدفع بالبطاقة (Paymob) — اختيارية بالكامل. من غيرها الدفع بالبطاقة بيرفض بوضوح
# (PAY_001) لكن الكاش والمحفظة بيشتغلوا عادي. تفاصيل الحصول على كل قيمة + مكانها بالظبط:
# docs/03-external-integrations.md → قسم Paymob.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_MOBILE_WALLET=
PAYMOB_HMAC_SECRET=

# بوابة تانية جنب Paymob — كود مرجعي FawryPay ("ادفع في أقرب فوري"). اختيارية بالكامل برضه.
# ⚠️ راجع docs/03-external-integrations.md → قسم FawryPay قبل أي استخدام إنتاجي — توقيع
# الطلبات/الـ webhook محتاج تحقق مباشر ضد sandbox حقيقي.
FAWRY_BASE_URL=https://atfawry.fawrystaging.com
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=
FAWRY_REFERENCE_EXPIRY_HOURS=72

# InstaPay: عنوان IPA/اسم المستلم بقوا يتعدّلوا من لوحة تحكم الأدمن (/admin/settings، صلاحية
# super_admin بس) مش env vars — راجع docs/03-external-integrations.md → قسم InstaPay.

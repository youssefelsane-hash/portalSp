# baytak api — انسخه لـ .env محلياً

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

DATABASE_URL=postgres://baytak:baytak@localhost:5432/baytak

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# تخزين محلي في التطوير بس — الإنتاج يبدّلها S3-compatible (راجع common/storage/README لو موجود)
STORAGE_LOCAL_DIR=./uploads

# كاش (SettingsService حالياً) — لو مش شغال، الكود بيرجع يقرا من القاعدة مباشرة من غير ما يفشل
REDIS_URL=redis://localhost:6379

# بوابة الدفع بالبطاقة (Paymob) — اختيارية بالكامل. من غيرها الدفع بالبطاقة بيرفض بوضوح
# (PAY_001) لكن الكاش والمحفظة بيشتغلوا عادي. تفاصيل الحصول على كل قيمة + مكانها بالظبط:
# docs/03-external-integrations.md → قسم Paymob.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# baytak api — انسخه لـ .env محلياً

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

DATABASE_URL=postgres://baytak:baytak@localhost:5432/baytak

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# قائمة أصول (origins) مسموح لها بنداء الـAPI من متصفح، مفصولة بفاصلة (مثال:
# https://admin.baytak.com,https://baytak.com). فاضي = مفتوح للكل (*) — مقبول محلياً/تطويرياً
# بس، السيرفر بيرفض يشتغل لو سيبتها فاضية وNODE_ENV=production (راجع src/config/env.validation.ts).
CORS_ORIGIN=

OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# WebAuthn/Passkeys لدخول الأدمن عالي الصلاحية (ADR-0011) — القيم دي افتراضاتها مضبوطة لبيئة
# التطوير المحلية (apps/admin على 3001) وشغالة من غير أي تعديل. **لازم تتظبط صح في الإنتاج**:
# WEBAUTHN_RP_ID = دومين لوحة الأدمن الحقيقي بدون بروتوكول (مثال: admin.baytak.com)،
# WEBAUTHN_ORIGIN = نفس الدومين كامل بالـhttps (مثال: https://admin.baytak.com) — غلط في القيمتين
# دول بيخلي كل WebAuthn ceremony يترفض من المتصفح نفسه (WebAuthn spec، مش قيد من كودنا).
WEBAUTHN_RP_NAME=صُنّاع — لوحة التحكم
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001

# تخزين الملفات — 'local' (افتراضي، للتطوير) أو 's3'. راجع common/storage/README.md
# و docs/03-external-integrations.md لتفاصيل كل قيمة S3.
# docs/08 §19 بند 16: 's3' إجباري لو NODE_ENV=production — السيرفر يرفض يقلع بـ'local' في الإنتاج
# (ملف مؤقت بيتمسح مع كل deploy، مش متاح لأكتر من instance).
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# القيم دي مطلوبة فعلياً بس لو STORAGE_PROVIDER=s3 — تشتغل مع AWS S3 نفسه (اسيب S3_ENDPOINT فاضي)
# أو أي بديل S3-compatible زي DigitalOcean Spaces / Cloudflare R2 / MinIO (لازم S3_ENDPOINT).
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
STORAGE_S3_URL_EXPIRY_SECONDS=604800

# قنوات الإشعارات الخارجية — كل واحدة اختيارية ومستقلة عن الباقي. قناة مش مُعدّة بترجع
# log-only (بتتسجّل في اللوج بس) بدل ما تفشّل أو توقف باقي القنوات. تفاصيل كل قيمة:
# docs/03-external-integrations.md
# استثناء واحد (docs/08 §19 بند 16): TWILIO_ACCOUNT_SID/AUTH_TOKEN/SMS_FROM_NUMBER الثلاثة
# إجباريين مع بعض لو NODE_ENV=production — القناة الوحيدة لتسليم كود OTP، من غيرها مفيش مستخدم
# حقيقي يقدر يسجّل دخول أصلاً (السيرفر يرفض يقلع بدل ما OTP يرجع 200 بلا ما حد يستلمه فعليًا).
FIREBASE_SERVICE_ACCOUNT_JSON=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=
TWILIO_WHATSAPP_FROM_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# كاش (SettingsService حالياً) — لو مش شغال، الكود بيرجع يقرا من القاعدة مباشرة من غير ما يفشل
REDIS_URL=redis://localhost:6379

# بوابة الدفع بالبطاقة (Paymob) — اختيارية بالكامل. من غيرها الدفع بالبطاقة بيرفض بوضوح
# (PAY_001) لكن الكاش والمحفظة بيشتغلوا عادي. تفاصيل الحصول على كل قيمة + مكانها بالظبط:
# docs/03-external-integrations.md → قسم Paymob.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# بوابة تانية جنب Paymob — كود مرجعي FawryPay ("ادفع في أقرب فوري"). اختيارية بالكامل برضه.
# ⚠️ راجع docs/03-external-integrations.md → قسم FawryPay قبل أي استخدام إنتاجي — توقيع
# الطلبات/الـ webhook محتاج تحقق مباشر ضد sandbox حقيقي.
FAWRY_BASE_URL=https://atfawry.fawrystaging.com
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=
FAWRY_REFERENCE_EXPIRY_HOURS=72

#include "Generated.xcconfig"
// بوابة P0-2 في docs/23 — مفتاح خرائط Google بيتقرا من هنا (`GOOGLE_MAPS_API_KEY`)، غير
// متتبَّع في git. انسخ Local.xcconfig.example لـLocal.xcconfig وحط فيه المفتاح الحقيقي.
// `?` يخلي الـinclude اختياري عشان البناء ميفشلش لو الملف مش موجود (الخرائط بس هتفضل معطّلة).
#include? "Local.xcconfig"

// صلاحية إشعارات APNs (`aps-environment`) — مربوطة من هنا مش من pbxproj عمدًا: الـxcconfig دي
// مرجع البناء لهدف Runner وحده (هدف RunnerTests مالوش baseConfigurationReference خالص)، فالربط
// هنا أبسط وأأمن من تعديل project.pbxproj بالإيد. من غير السطر ده الملف بيبقى موجود بلا أثر.
CODE_SIGN_ENTITLEMENTS = Runner/Runner.entitlements

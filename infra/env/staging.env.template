# ================================================================================================
# قالب بيئة staging (ج-١٤) — انسخه واملا القيم الحقيقية، وما تعملهوش commit بعد ما تملاه.
#
# **ليه القالب ده موجود**: القيمة الوحيدة لـstaging إنها تكشف الأعطال قبل العملاء. staging
# مختلفة عن الإنتاج في حاجة جوهرية بتدّي العكس: **ثقة كاذبة**. القالب ده بيثبّت اللي لازم
# يتطابق ويسيب اللي لازم يختلف.
#
# للتحقق قبل النشر:
#   node scripts/env-parity-check.js --env <ملفك> --as staging
#
# القيم هنا **placeholders بالشكل الصح** (طول كافي، بلا علامات تطويرية) عشان القالب نفسه يعدّي
# على الفحص — وده اللي بيثبت إن الفاحص مش «بيرفض كل حاجة».
# ================================================================================================

# ── لازم يتطابق مع الإنتاج (شكل النظام) ──────────────────────────────────────────────────────
# تغيير أي واحدة فيهم بيخلّي staging بتختبر نظامًا تاني خالص.
NODE_ENV=staging
API_PREFIX=api/v1
# **أخطر فرق ممكن**: محلي مقابل s3 بيغيّر شكل الروابط والصلاحيات بالكامل. اتلقط في ج-١٣: رابط
# `/uploads/...` صحيح مع السوّاق المحلي و404 مع s3.
STORAGE_PROVIDER=s3

# ── لازم يختلف عن الإنتاج (العزل) ────────────────────────────────────────────────────────────
# قاعدة/بكت/أسرار مشتركة معناها إن تدقيق على staging بيلمس بيانات وفلوس عملاء حقيقيين.
DATABASE_URL=postgres://baytak_staging:REPLACE_WITH_REAL_PASSWORD@db.staging.internal:5432/baytak_staging
REDIS_URL=redis://redis.staging.internal:6379
S3_BUCKET=baytak-staging-media
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=REPLACE_WITH_STAGING_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_WITH_STAGING_SECRET
S3_FORCE_PATH_STYLE=false

# أسرار مستقلة تمامًا — سر مشترك معناه إن توكن اتولّد على staging شغّال على الإنتاج.
# ولّدها بـ: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_WITH_48_BYTE_RANDOM_VALUE_NOT_THE_PROD_ONE
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_48_BYTE_RANDOM_VALUE_DIFFERENT
JWT_REFRESH_EXPIRES_IN=30d
# **تغييره بعد التشغيل بيبطّل فك كل القيم المحفوظة** — ثبّته من أول يوم.
SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_32_PLUS_CHAR_RANDOM_STAGING_KEY
PII_ENCRYPTION_KEY=REPLACE_WITH_32_PLUS_CHAR_RANDOM_STAGING_PII_KEY

# ── نفس صرامة الإنتاج (مش أرخى) ──────────────────────────────────────────────────────────────
# CORS فاضي = مفتوح للكل، والسيرفر بيرفض الإقلاع عليه في بيئة production-like. تركه مفتوح على
# staging بيخلّيها تعدّي حاجة الإنتاج هيرفضها وقت الإقلاع — النشر بيفشل **بعد** ما staging قالت تمام.
CORS_ORIGIN=https://admin.staging.baytak.example,https://staging.baytak.example
WEBAUTHN_RP_NAME=baytak staging
WEBAUTHN_RP_ID=staging.baytak.example
WEBAUTHN_ORIGIN=https://admin.staging.baytak.example
# **سيبها على الافتراضي (٦٠)**. رفعها بيتعمل محليًا عشان أدوات التدقيق بس (موثّق في
# `app.module.ts`) — على staging بيخلّيها تختبر نظامًا بلا حدود، وتدقيق ج-٩ بيقف صراحةً لو لقاها مرفوعة.
# THROTTLE_LIMIT=60
# THROTTLE_TTL_MS=60000

# ── سعة القاعدة — نفس أرقام الإنتاج ──────────────────────────────────────────────────────────
# staging بـpool أوسع من الإنتاج مش هتكشف أبدًا رفض الـ503 تحت التزامن (ده كان P0-1 حقيقي).
DATABASE_POOL_MAX=20
DATABASE_ACQUIRE_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# ── خدمات خارجية ─────────────────────────────────────────────────────────────────────────────
# بوابة SMS مطلوبة فعلاً: من غيرها مفيش مستخدم يقدر يسجّل دخول أصلاً على staging.
# استخدم حساب/رقم مخصّص لـstaging — مش نفس الحساب اللي بيبعت لعملاء حقيقيين.
TWILIO_ACCOUNT_SID=REPLACE_WITH_STAGING_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_STAGING_TOKEN
TWILIO_SMS_FROM_NUMBER=+10000000000

PORT=3000
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

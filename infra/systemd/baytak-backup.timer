# جدولة النسخة اليومية (ج-١٠) — شوف `baytak-backup.service` لتفاصيل التركيب.

[Unit]
Description=تشغيل نسخة baytak الاحتياطية يوميًا

[Timer]
# ٣ الفجر بتوقيت القاهرة = ١:٠٠ UTC. الوقت مختار في أقل ساعات الحمل الحقيقي.
OnCalendar=*-*-* 01:00:00 UTC
# لو السيرفر كان مقفول وقت الميعاد، النسخة بتتاخد أول ما يشتغل — مش بتتفوّت لبكرة.
Persistent=true
# تشتيت عشوائي لحد ٥ دقايق: لو أكتر من سيرفر بياخد نسخة، مايضربوش القاعدة في نفس اللحظة.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
